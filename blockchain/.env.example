# Blockchain Environment Configuration
# Copy this file to .env and update values

# Private key for deployment (use a test account, NEVER use mainnet keys)
# Generate with: openssl rand -hex 32
PRIVATE_KEY=

# Local Hardhat RPC URL
RPC_URL=http://127.0.0.1:8545

# Contract address after deployment
CONTRACT_ADDRESS=

# Sepolia Testnet (optional)
SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# Gas reporting
REPORT_GAS=false