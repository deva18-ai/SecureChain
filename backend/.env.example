# Backend Environment Configuration
# Copy this file to .env and update values

# App
APP_NAME=SecureChain API
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
# PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/securechain

# JWT
# Generate a secure secret: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Blockchain
# Local Hardhat node RPC URL
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
# Contract address after deployment (update after running deploy script)
CONTRACT_ADDRESS=
# Deployer private key for backend to sign transactions (NEVER commit real keys)
DEPLOYER_PRIVATE_KEY=

# Redis (optional, for caching/celery)
REDIS_URL=redis://localhost:6379/0

# CORS
# Frontend URLs allowed to access the API
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100